msgid "Password reset sent"
msgstr "Redefinição de senha enviada"

#: .\storevenv\Lib\site-packages\django\contrib\auth\views.py:254
msgid "Enter new password"
msgstr "Digite a nova senha"

#: .\storevenv\Lib\site-packages\django\contrib\auth\views.py:314
msgid "Password reset unsuccessful"
msgstr "Redefinição de senha sem sucesso"

#: .\storevenv\Lib\site-packages\django\contrib\auth\views.py:322
msgid "Password reset complete"
msgstr "Redefinição de senha completa"

#: .\storevenv\Lib\site-packages\django\contrib\auth\views.py:334
msgid "Password change"
msgstr "Alteração de Senha"

